<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-first launch theme. Parenting Light.NoActionBar flashed white on every
      cold start. windowBackground follows pinot_bg (light in values/, dark in
      values-night/) so the common case where system night matches the app is
      correct; Compose Theme.kt paints bars from the in-app darkTheme toggle.
    -->
    <style name="Theme.PinotRouge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pinot_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/pinot_accent</item>
        <item name="android:colorAccent">@color/pinot_accent</item>
        <item name="android:textColorPrimary">@color/pinot_text</item>
    </style>
</resources>
